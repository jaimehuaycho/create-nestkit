{
  "id": "database",
  "label": "Database (TypeORM)",
  "requires": [],
  "appModule": {
    "imports": [
      "import { DatabaseModule } from './database/database.module.js';"
    ],
    "modules": ["DatabaseModule"]
  },
  "envVars": [
    "DB_TYPE", "DB_HOST", "DB_PORT", "DB_USER",
    "DB_PASSWORD", "DB_NAME", "DB_LOGS",
    "SEED_ROOT_EMAIL", "SEED_ROOT_PASSWORD"
  ],
  "dependencies": {
    "prod": ["@nestjs/typeorm", "typeorm"],
    "dev": ["tsx"]
  },
  "scripts": {
    "typeorm":            "tsx ./node_modules/typeorm/cli.js --dataSource src/database/config/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run":      "npm run typeorm -- migration:run",
    "migration:revert":   "npm run typeorm -- migration:revert",
    "seed":               "tsx src/database/seeds/seed.ts"
  }
}
