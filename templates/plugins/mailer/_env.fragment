    // -- Plugin: mailer -------------------------------------------------------
    // Which variables each transport needs is declared in src/plugins/mailer/transports/index.ts, which checks them at startup.
    MAIL_TRANSPORT:        Joi.string().default('log'),
    MAIL_FROM:             Joi.string().optional(),
    SMTP_HOST:             Joi.string().optional(),
    SMTP_PORT:             Joi.number().default(587),
    SMTP_USER:             Joi.string().optional(),
    SMTP_PASS:             Joi.string().optional(),
    RESEND_API_KEY:        Joi.string().optional(),
    POSTMARK_SERVER_TOKEN: Joi.string().optional(),
    SENDGRID_API_KEY:      Joi.string().optional(),
    AWS_REGION:            Joi.string().optional(),
    AWS_ACCESS_KEY_ID:     Joi.string().optional(),
    AWS_SECRET_ACCESS_KEY: Joi.string().optional(),
    AWS_SESSION_TOKEN:     Joi.string().optional(),
