{
  "id": "mailer",
  "label": "Mailer (SMTP or HTTP API)",
  "requires": [],
  "appModule": {
    "imports": [
      "import { MailerModule } from './plugins/mailer/mailer.module.js';"
    ],
    "modules": ["MailerModule.register()"]
  },
  "envVars": [
    "MAILER_TRANSPORT",
    "SMTP_HOST",
