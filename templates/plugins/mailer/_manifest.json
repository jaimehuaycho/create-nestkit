{
  "id": "mailer",
  "label": "Mailer (SMTP, Resend, Postmark, SendGrid or SES)",
  "requires": [],
  "appModule": {
    "imports": [
      "import { MailerModule } from './plugins/mailer/mailer.module.js';"
    ],
    "modules": [
      "MailerModule"
    ]
  },
  "envVars": [
    "MAIL_TRANSPORT",
    "MAIL_FROM",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "RESEND_API_KEY",
    "POSTMARK_SERVER_TOKEN",
    "SENDGRID_API_KEY",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN"
  ],
  "nestAssets": [
    "plugins/mailer/templates/**/*"
  ],
  "dependencies": {
    "prod": [
      "@nestjs/mail"
    ],
    "dev": []
  },
  "scripts": {},
  "overlays": [
    {
      "dir": "_overlays/esm-tests",
      "when": {
        "moduleSystem": "esm"
      }
    },
    {
      "dir": "_overlays/auth",
      "when": {
        "plugin": "auth"
      }
    }
  ],
  "gitignore": [
    "/var"
  ]
}
