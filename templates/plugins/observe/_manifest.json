{
  "id": "observe",
  "label": "Observability (Nest Observe)",
  "requires": [],
  "minNestMajor": 12,
  "appModule": {
    "imports": [
      "import { ObserveModule } from './config/helpers/observe.js';"
    ],
    "modules": [
      "ObserveModule.forRoot({ appKey: process.env.OBSERVE_APP_KEY!, appSecret: process.env.OBSERVE_APP_SECRET!, serviceId: process.env.OBSERVE_SERVICE_ID ?? 'app' })"
    ]
  },
  "envVars": [
    "OBSERVE_APP_KEY",
    "OBSERVE_APP_SECRET",
    "OBSERVE_SERVICE_ID"
  ],
  "dependencies": {
    "prod": ["@nestjs/observe"],
    "dev": []
  },
  "scripts": {}
}
