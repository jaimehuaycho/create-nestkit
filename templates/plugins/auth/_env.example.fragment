
# Auth (JWT)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_TIME_EXPIRE=15m
REFRESH_TOKEN_TTL=7d
REFRESH_FAMILY_TTL=30d

# Two-factor authentication (TOTP): 32-byte key, 64 hex characters. It encrypts the TOTP secrets in the database: if you lose it,
# users must set 2FA up again. Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32_64_hex_characters_here_please
