{
  "id": "auth",
  "label": "Authentication (JWT, refresh token families, e-mail codes, TOTP 2FA)",
  "requires": [
    "database",
    "users",
    "roles"
  ],
  "appModule": {
    "imports": [
      "import { AuthModule } from './app/auth/auth.module.js';"
    ],
    "modules": [
      "AuthModule"
    ]
  },
  "envVars": [
    "JWT_SECRET",
    "JWT_TIME_EXPIRE",
    "REFRESH_TOKEN_TTL",
    "REFRESH_FAMILY_TTL",
    "TWO_FACTOR_ENCRYPTION_KEY"
  ],
  "dependencies": {
    "prod": [
      "@nestjs/jwt",
      "@nestjs/passport",
      "passport",
      "passport-jwt",
      "otpauth"
    ],
    "dev": [
      "@types/passport-jwt"
    ]
  },
  "scripts": {}
}
