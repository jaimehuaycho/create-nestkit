{
  "compilerOptions": {
    "target":              "ES2021",
    "module":              "commonjs",
    "outDir":              "./dist",
    "rootDir":             "./src",
    "strict":              false,
    "skipLibCheck":        true,
    "types":               ["node"],
    "resolveJsonModule":   true,
    "esModuleInterop":     true,
    "tsBuildInfoFile":     ".tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
