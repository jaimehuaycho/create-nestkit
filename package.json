{
  "name": "@darkj/create-nestkit",
  "version": "1.2.1",
  "description": "CLI to scaffold NestJS projects with a modular, production-ready structure",
  "author": "jaimehuaycho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaimehuaycho/create-nestkit.git"
  },
  "bugs": {
    "url": "https://github.com/jaimehuaycho/create-nestkit/issues"
  },
  "homepage": "https://github.com/jaimehuaycho/create-nestkit#readme",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-nestkit": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm test && npm run check:package"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!**/.env",
    "!**/.env.local",
    "!**/*.log",
    "!**/*.tmp",
    "!**/*.bak",
    "!**/*.swp",
    "!**/*.tgz",
    "!**/.idea",
    "!**/.vscode"
  ],
  "keywords": [
    "nestjs",
    "scaffold",
    "cli",
    "generator",
    "typescript"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
